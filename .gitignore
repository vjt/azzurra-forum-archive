# Regenerated from pages/ by forum_import.py in ~30 seconds, and 169 MB — over
# GitHub's 100 MB per-file limit. The pages are the archaeology; the DB is a build
# artifact.
forum.db
forum.db-wal
forum.db-shm
__pycache__/

# retry/ IS tracked on purpose: the losing candidates are Archive material too, and
# refetching them costs hours. Only the DB stays out.

# site/ is generated: forum_render.py rebuilds the 6706 pages in 14 seconds and
# bin/pagefind indexes them in 27. Same reasoning as forum.db — the sources are the
# archaeology, the rendered site is a build artifact.
site/

# Fetch logs and the miss lists they write: run artefacts, not archaeology. The
# assets themselves ARE tracked, same reasoning as retry/ — hours of polite
# crawling against the Archive that nobody should have to spend twice.
*.log
assets_miss*.txt
assets_miss.tmp
assets_fetch.done
forum.db.bak
forum.db.pre-divfix
